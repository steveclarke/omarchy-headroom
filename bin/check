#!/usr/bin/env python3
"""Run Headroom's unit, manifest and Qt 6 QML checks."""
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parents[1]
os.chdir(root)
subprocess.run([sys.executable, '-B', '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_*.py'], check=True)
subprocess.run(['/usr/bin/node', '--test', 'tests/pace.test.cjs', 'tests/costs.test.cjs', 'tests/wire.test.cjs', 'tests/providers.test.cjs'], check=True)
subprocess.run([sys.executable, str(root / 'tests/check-qml')], check=True)
subprocess.run([sys.executable, str(root / 'tools/check-no-personal-data')], check=True)
subprocess.run(['omarchy', 'plugin', 'validate', str(root)], check=True)

shell = Path(os.environ.get('OMARCHY_PATH', '/usr/share/omarchy')) / 'shell'
with tempfile.TemporaryDirectory(prefix='headroom-lint-') as temp:
    namespace = Path(temp) / 'qs'
    namespace.mkdir()
    for module in shell.iterdir():
        if (module / 'qmldir').is_file():
            (namespace / module.name).symlink_to(module, target_is_directory=True)
    command = ['/usr/lib/qt6/bin/qmllint', '-I', temp]
    def unexpected(output):
        # Native QtObject singletons generate these two warning classes in
        # first-party panels too. Wrong signals must never be hidden by them.
        return [line for line in output.splitlines()
                if ('no matching signal found for handler' in line)
                or (re.match(r'^(Error|Warning):', line)
                    and not re.search(r'\[(unqualified|missing-property)\]$', line)
                    and 'Type QProcess::ExitStatus of parameter exitStatus in signal called exited' not in line)]
    control = Path(temp) / 'Invalid.qml'
    control.write_text('import QtQuick\nItem { onDefinitelyMissing: {} }\n')
    probe = subprocess.run(command + [str(control)], capture_output=True, text=True)
    if not unexpected(probe.stdout + probe.stderr):
        raise SystemExit('QML lint positive control failed')
    result = subprocess.run(command + ['BarWidget.qml', 'Panel.qml', 'Service.qml', 'TintedIcon.qml', 'CollectorProcess.qml', 'SettingsView.qml', 'ProviderReorder.qml', 'ProviderDragHandle.qml'], capture_output=True, text=True)
    findings = unexpected(result.stdout + result.stderr)
    if findings or result.returncode not in (0, 255):
        print(result.stdout + result.stderr)
        raise SystemExit('QML lint failed')
print('Headroom checks passed')
