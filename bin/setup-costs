#!/usr/bin/env python3
"""Install Headroom's pinned local cost reader. Quota collection needs no Node dependencies."""
from pathlib import Path
import shutil
import subprocess
import sys

if not shutil.which("bun"):
    sys.exit("Install Bun, then run bin/setup-costs again.")
runtime = Path(__file__).resolve().parents[1] / "runtime"
subprocess.run(["bun", "install", "--cwd", str(runtime), "--frozen-lockfile"], check=True)
subprocess.run([str(runtime / "node_modules/.bin/ccusage"), "--version"], check=True)
