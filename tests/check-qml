#!/usr/bin/env python3
"""Exercise actual QML worker boundaries offscreen, using only generated helpers."""
from pathlib import Path
import os,subprocess,tempfile,shutil,json
source=Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix='headroom-qml-review-') as directory:
 root=Path(directory)
 for name in ('CollectorProcess.qml','Wire.js','Service.qml','Costs.js','Model.js','Providers.js','providers.json'): shutil.copyfile(source/name,root/name)
 (root/'bin').mkdir()
 doc={'schema':1,'observedAt':100,'providers':[{'id':id,'state':'fresh','message':'','daily':{}} for id in ('claude','codex')]}
 for mode in ('valid','malformed','oversized','stderr','cancel'):
  script='import sys,time\n'
  if mode=='valid': script+='print('+repr(json.dumps(doc))+')\n'
  elif mode=='malformed': script+='print(\'{"schema":1,"providers":[{},{}]}\')\n'
  elif mode=='oversized': script+='print("x"*200000)\n'
  elif mode=='stderr': script+='sys.stderr.write("x"*20000); print('+repr(json.dumps(doc))+')\n'
  else: script+='time.sleep(30)\n'
  (root/'bin/headroom-collect').write_text(script)
  callback='console.log("FIXTURE_COMPLETED"); Qt.quit()' if mode=='valid' else 'console.log("UNEXPECTED_COMPLETION"); Qt.exit(2)'
  failure='console.log("FIXTURE_FAILED_CLOSED"); Qt.quit()' if mode in ('malformed','oversized','stderr') else 'console.log("UNEXPECTED_FAILURE"); Qt.exit(2)'
  cancel='Timer { interval:100; running:true; onTriggered: c.cancel() } Timer { interval:500; running:true; onTriggered: { if (c.active) Qt.exit(3); else { console.log("FIXTURE_CANCELLED"); Qt.quit() } } }' if mode=='cancel' else ''
  (root/'shell.qml').write_text('import QtQuick\nimport Quickshell\nShellRoot { CollectorProcess { id:c; costs:true; providerIds:["claude","codex"]; onCompleted: {'+callback+'} onFailed: {'+failure+'} } Component.onCompleted:c.start(); Timer { interval:3000; running:true; onTriggered:Qt.exit(4) } '+cancel+' }')
  runtime=root/'runtime'; runtime.mkdir(mode=0o700,exist_ok=True)
  env=dict(os.environ,QT_QPA_PLATFORM='offscreen',QT_QPA_PLATFORMTHEME='',QT_QUICK_CONTROLS_STYLE='Basic',XDG_RUNTIME_DIR=str(runtime));env.pop('WAYLAND_DISPLAY',None);env.pop('DISPLAY',None)
  result=subprocess.run(['/usr/bin/quickshell','-p',str(root/'shell.qml')],env=env,capture_output=True,text=True,timeout=5)
  output=result.stdout+result.stderr
  if result.returncode or 'UNEXPECTED_' in output or 'FIXTURE_' not in output: print(mode,output);raise SystemExit(1)
  print(mode+': '+next(line.strip() for line in output.splitlines() if 'FIXTURE_' in line))

 # Service timers must recover after either a manual or scheduled clock rollback.
 for mode in ('manual-clock', 'scheduled-clock'):
  (root/'bin/headroom-collect').write_text('print('+repr(json.dumps(doc))+')\n')
  action = 's.refresh();' if mode == 'manual-clock' else ''
  (root/'shell.qml').write_text('import QtQuick\nimport Quickshell\nShellRoot { Service { id:s } Timer { interval:1300; running:true; onTriggered:{ s.lastAttemptAt=Date.now()+3600000; s.lastCostAttemptAt=s.lastAttemptAt; s.nextRefreshAt=s.lastAttemptAt; s.nextCostRefreshAt=s.lastAttemptAt; s.nowMs=s.lastAttemptAt; '+action+' } } Timer { interval:2500; running:true; onTriggered:{ if(s.batchesStarted<2) Qt.exit(3); else {console.log("FIXTURE_CLOCK_RECOVERED");Qt.quit()} } } }')
  result=subprocess.run(['/usr/bin/quickshell','-p',str(root/'shell.qml')],env=env,capture_output=True,text=True,timeout=4)
  output=result.stdout+result.stderr
  if result.returncode or 'FIXTURE_CLOCK_RECOVERED' not in output: print(mode,output);raise SystemExit(1)
  print(mode+': FIXTURE_CLOCK_RECOVERED')

 # Real service selection changes, with fake native settings and helper I/O.
 helper = '''import argparse,json,time
from pathlib import Path
p=argparse.ArgumentParser(); p.add_argument('--parent'); p.add_argument('--costs',action='store_true'); p.add_argument('--providers',nargs='*'); a=p.parse_args()
with Path(__file__).with_name('requests.jsonl').open('a') as log: log.write(json.dumps({'costs':a.costs,'ids':a.providers})+'\\n')
time.sleep(.35)
now=time.time()*1000
providers=[dict(id=id,state='fresh',message='',**({'daily':{}} if a.costs else {'name':id,'plan':'','observedAt':now,'windows':[{'id':'weekly','title':'Weekly','used':.2,'resetAt':now+86400000,'durationMs':604800000}]})) for id in a.providers]
print(json.dumps({'schema':1,'observedAt':now,'providers':providers}))
'''
 (root/'bin/headroom-collect').write_text(helper)
 for mode in ('selection-race', 'reorder', 'disabled-startup'):
  requests=root/'bin/requests.jsonl'; requests.unlink(missing_ok=True)
  initial={'id':'io.github.steveclarke.headroom','enabled':True,'keep':'native-option'}
  if mode=='disabled-startup': initial.update(providers={'claude':{'display':'off'},'codex':{'display':'off'}},showCosts=False)
  mock='QtObject { id:host; property var shellConfig: ({bar:{layout:{center:['+json.dumps(initial)+']}}}); function updateEntryInline(id,value) { shellConfig={bar:{layout:{center:[value]}}}; return true } }'
  functions='''function require(value,message) { if(!value) { console.log("UNEXPECTED_"+message); Qt.exit(3) } }
function change(order,claude,codex,costs) { require(s.savePreferences({providerOrder:order,providers:{claude:{display:claude},codex:{display:codex}},showCosts:costs}),"save"); require(host.shellConfig.bar.layout.center[0].keep==="native-option","native-options") }
'''
  if mode=='selection-race':
   actions='''Timer {interval:150;running:true;onTriggered:s.refresh()}
Timer {interval:250;running:true;onTriggered:change(["claude","codex"],"off","bar",false)}
Timer {interval:2100;running:true;onTriggered:{require(s.providers.length===1 && s.providers[0].id==="codex" && s.providers[0].state==="fresh","selected-result");require(s.costs.providers.length===0 && !s.costsRefreshing,"costs-stopped:"+JSON.stringify({ids:s.costIds,costs:s.costs,active:s.costsRefreshing,selection:s.activeCostSelection,preferences:s.preferences}));change(["claude","codex"],"off","off",false)}}
Timer {interval:2900;running:true;onTriggered:{require(s.providers.length===0 && !s.refreshing,"all-off");console.log("FIXTURE_SELECTION_RACE");Qt.quit()}}
'''
  elif mode=='reorder':
   actions='''Timer {interval:150;running:true;onTriggered:s.refresh()}
Timer {interval:750;running:true;onTriggered:change(["codex","claude"],"panel","bar",true)}
Timer {interval:1700;running:true;onTriggered:{require(s.providers.map(p=>p.id).join(",")==="codex,claude","display-order");require(s.barProviders.length===1 && s.barProviders[0].id==="codex","panel-only");require(s.costs.providers.length===2 && s.costs.providers.every(p=>p.state==="fresh"),"costs-retained");require(s.batchesStarted===1,"no-recollection");console.log("FIXTURE_REORDER");Qt.quit()}}
'''
  else:
   actions='''Timer {interval:1500;running:true;onTriggered:{require(s.batchesStarted===0 && s.providers.length===0 && s.costs.providers.length===0,"disabled-startup");console.log("FIXTURE_DISABLED_STARTUP");Qt.quit()}}'''
  (root/'shell.qml').write_text('import QtQuick\nimport Quickshell\nShellRoot { '+mock+' Service {id:s;shell:host} '+functions+actions+' Timer {interval:3500;running:true;onTriggered:Qt.exit(4)} }')
  result=subprocess.run(['/usr/bin/quickshell','-p',str(root/'shell.qml')],env=env,capture_output=True,text=True,timeout=5)
  output=result.stdout+result.stderr
  if result.returncode or 'UNEXPECTED_' in output or 'FIXTURE_' not in output or 'TypeError' in output or 'ReferenceError' in output: print(mode,output);raise SystemExit(1)
  calls=[json.loads(line) for line in requests.read_text().splitlines()] if requests.exists() else []
  if mode=='selection-race':
   assert sorted((call['costs'],','.join(call['ids'])) for call in calls)==[(False,'claude,codex'),(False,'codex'),(True,'claude,codex')], calls
  elif mode=='reorder': assert len(calls)==2 and all(call['ids']==['claude','codex'] for call in calls), calls
  else: assert calls==[], calls
  print(mode+': '+next(line.strip() for line in output.splitlines() if 'FIXTURE_' in line))

 # Settings uses native controls with a synthetic shared persistence service.
 # No real shell is launched, configuration written, or provider called.
 for name in ('SettingsView.qml', 'PillButton.qml', 'TintedIcon.qml'):
  shutil.copyfile(source/name, root/name)
 shutil.copytree(source/'assets', root/'assets')
 namespace=root/'qs'; namespace.mkdir()
 native=Path(os.environ.get('OMARCHY_PATH','/usr/share/omarchy'))/'shell'
 for module in native.iterdir():
  if (module/'qmldir').is_file(): (namespace/module.name).symlink_to(module, target_is_directory=True)
 settings_env=dict(env,QML_IMPORT_PATH=str(root))
 catalog=json.loads((source/'providers.json').read_text())['providers']
 mock='''QtObject {
  id:host
  property var catalog: CATALOG
  property var preferences: ({providerOrder:["claude","codex"],providers:{claude:{display:"bar"},codex:{display:"bar"}},showCosts:true})
  property var providers: []
  property double nowMs: Date.now()
  property int saves:0
  property bool reject:false
  function savePreferences(value) { if(reject) return false; saves++; preferences=value; return true }
 }'''.replace('CATALOG',json.dumps(catalog))
 views=' '.join('SettingsView {id:'+id+';width:400;service:host;ink:"#222222";dim:"#555555";surface:"#ffffff";group:"#eeeeee";track:"#dddddd"}' for id in ('first','second'))
 cases={
 'settings-immediate':'''first.display("claude","panel");first.setCosts(false);first.reorder("codex",-1);
 require(host.saves===3,"saved-on-change");require(second.preferences.providers.claude.display==="panel" && !second.preferences.showCosts && second.preferences.providerOrder[0]==="codex","shared-view");
 var saves=host.saves;first.done();first.begin();require(host.saves===saves && !first.preferences.showCosts,"done-keeps-changes");''',
 'settings-rejection':'''host.reject=true;first.display("claude","off");first.setCosts(false);first.reorder("codex",-1);
 require(host.saves===0 && first.error!=="","save-error");require(first.preferences.providers.claude.display==="bar" && first.preferences.showCosts && first.preferences.providerOrder[0]==="claude","saved-values-retained");
 host.reject=false;first.display("claude","off");require(first.error==="" && second.preferences.providers.claude.display==="off","retry");''',
 'settings-concurrent':'''second.setCosts(false);second.reorder("codex",-1);first.display("claude","off");
 require(!host.preferences.showCosts && host.preferences.providerOrder[0]==="codex" && host.preferences.providers.claude.display==="off","other-view-changes-preserved");'''
 }
 for mode,actions in cases.items():
  (root/'shell.qml').write_text('import QtQuick\nimport Quickshell\nShellRoot { '+mock+' Item {'+views+'} function require(value,message) {if(!value) throw new Error(message)} Timer {interval:300;running:true;onTriggered:{try{first.begin();second.begin();'+actions+'console.log("FIXTURE_SETTINGS_PASSED");Qt.quit()}catch(e){console.log("UNEXPECTED_"+e);Qt.exit(3)}}} Timer {interval:3000;running:true;onTriggered:Qt.exit(4)} }')
  result=subprocess.run(['/usr/bin/quickshell','-p',str(root/'shell.qml')],env=settings_env,capture_output=True,text=True,timeout=5)
  output=result.stdout+result.stderr
  if result.returncode or 'FIXTURE_SETTINGS_PASSED' not in output or 'UNEXPECTED_' in output or 'TypeError' in output or 'ReferenceError' in output: print(mode,output);raise SystemExit(1)
  print(mode+': FIXTURE_SETTINGS_PASSED')
