#!/usr/bin/env python3
"""Native pointer tests. --desktop opens an isolated panel with synthetic data."""
from pathlib import Path
import argparse
import os
import re
import shutil
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--desktop', action='store_true')
args = parser.parse_args()
source = Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix='headroom-drag-') as directory:
    root = Path(directory)
    (root / 'app').symlink_to(source, target_is_directory=True)
    namespace = root / 'qs'
    namespace.mkdir()
    native = Path(os.environ.get('OMARCHY_PATH', '/usr/share/omarchy')) / 'shell'
    for module in native.iterdir():
        if (module / 'qmldir').is_file():
            (namespace / module.name).symlink_to(module, target_is_directory=True)
            (root / module.name).symlink_to(module, target_is_directory=True)
    env = dict(os.environ, QML_IMPORT_PATH=str(root), QT_QPA_PLATFORMTHEME='', QT_QUICK_CONTROLS_STYLE='Basic')
    if args.desktop:
        shutil.copyfile(source / 'tests/DragPanel.qml', root / 'shell.qml')
    else:
        runtime = root / 'runtime'
        runtime.mkdir(mode=0o700)
        env.update(QT_QPA_PLATFORM='offscreen', XDG_RUNTIME_DIR=str(runtime))
        env.pop('WAYLAND_DISPLAY', None)
        env.pop('DISPLAY', None)
        shutil.copyfile(source / 'tests/DragSettings.qml', root / 'DragSettings.qml')
        (root / 'shell.qml').write_text('import QtQuick\nimport Quickshell\nShellRoot { FloatingWindow { visible:true; implicitWidth:400; implicitHeight:650; DragSettings {} } }')
    def run(expected_failures):
        result = subprocess.run(['/usr/bin/quickshell', '-p', str(root / 'shell.qml')], env=env, capture_output=True, text=True, timeout=15)
        output = result.stdout + result.stderr
        counts = re.search(r'(?:MAIN_)?DRAG_RESULTS (\d+) (\d+)', output)
        if result.returncode or not counts or int(counts[1]) < 2 or int(counts[2]) != expected_failures:
            print(output)
            raise SystemExit('Native drag tests failed')
        return int(counts[1])
    passed = run(0)
    if not args.desktop:
        # Quickshell can exit zero after a failed QtTest case. Prove we check counts.
        fixture = root / 'DragSettings.qml'
        fixture.write_text(fixture.read_text().replace('name:"ProviderDrag"', 'name:"ProviderDrag"\n    function test_positive_control() { compare(1,2) }'))
        run(1)
    print(f'{passed} native drag checks passed' + ('; failure detection verified' if not args.desktop else ''))
